	pkgrel = 1
	url = https://github.com/davidamunga/handset
	arch = x86_64
	arch = aarch64
	license = Apache-2.0
	depends = alsa-lib
	depends = android-tools
	depends = glibc
	depends = hicolor-icon-theme
	depends = libgcc
	depends = libstdc++
	optdepends = ffmpeg: recording and styled exports
	optdepends = wl-clipboard: clipboard sync and copying captures on Wayland
	optdepends = xclip: clipboard sync and copying captures on X11
	optdepends = zenity: the address and pairing-code prompts and error dialogs
	optdepends = xdg-utils: opening links and captures
	optdepends = android-udev: USB access to phones without extra setup
	provides = handset
	conflicts = handset
	options = !strip
	options = !debug
